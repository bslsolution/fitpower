# NO importar este archivo en phpMyAdmin: no es SQL.
# Las claves van en api/.env (Administrador de archivos).
# En phpMyAdmin importá api/config/init.sql con la base ya seleccionada.

# Docker (local):
DB_HOST=db
DB_NAME=mi_base_de_datos
DB_USER=usuario
DB_PASS=password

# En Hostinger / InfinityFree: copiá este archivo a api/.env
# y reemplazá con los datos de MySQL que te da el panel.
# En Hostinger el host suele ser localhost.
# DB_HOST=localhost
# DB_NAME=uXXXX_fitpower
# DB_USER=uXXXX_fitpower
# DB_PASS=tu_clave
